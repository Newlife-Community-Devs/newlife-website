# Base URL of the deployed site
NEXTAUTH_URL=http://localhost:4080
NEXT_PUBLIC_URL=http://localhost:4080

# Secret used to sign the NextAuth session cookie (generate with: openssl rand -hex 32)
NEXTAUTH_SECRET=

# Latest sermon YouTube embed URL (public)
NEXT_PUBLIC_YOUTUBE_LIVE_LINK=

# Base URL of newlife-community-apis (no trailing slash).
# Optional: the app already defaults to the Render deployment.
# Use this to point local dev at a locally running API.
NEXT_PUBLIC_API_URL=http://localhost:8080
